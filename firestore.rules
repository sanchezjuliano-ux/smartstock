rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Get user planStatus
    function getPlanStatus(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.planStatus;
    }
    
    // Check if subscription/plan is active
    function isSubscriptionActive(userId) {
      return getPlanStatus(userId) == 'active' || getPlanStatus(userId) == 'trialling';
    }

    // Match users collection
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Match items collection
    match /items/{itemId} {
      allow read: if isAuthenticated() 
                  && resource.data.userId == request.auth.uid 
                  && isSubscriptionActive(request.auth.uid);
                  
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid 
                    && isSubscriptionActive(request.auth.uid);
                    
      allow update, delete: if isAuthenticated() 
                            && resource.data.userId == request.auth.uid 
                            && isSubscriptionActive(request.auth.uid);
    }
  }
}
