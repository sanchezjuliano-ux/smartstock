rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Shared pantry collection (profiles, inventory, history, categories)
    match /pantry/{docId} {
      allow read, write: if true;
    }

    // Default match for all documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
